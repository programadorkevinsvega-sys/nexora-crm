{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@crm/contracts": ["packages/contracts/src"],
      "@crm/contracts/*": ["packages/contracts/src/*"],
      "@crm/database": ["packages/database/src"],
      "@crm/database/*": ["packages/database/src/*"],
      "@crm/shared": ["packages/shared/src"],
      "@crm/shared/*": ["packages/shared/src/*"],
      "@crm/iam": ["packages/iam/src"],
      "@crm/iam/*": ["packages/iam/src/*"]
    }
  }
}
