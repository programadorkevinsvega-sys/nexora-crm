# ============================================================
# INFRASTRUCTURE & DATA SERVICES
# ============================================================
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sistema_crm
DATABASE_MAX_CONNECTIONS=25
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# ============================================================
# MODULAR MONOLITH BACKEND (apps/api)
# ============================================================
PORT=3005
API_CORE_GRPC_PORT=50059
CORS_ORIGIN=http://localhost:3000,http://localhost:3006
JWT_SECRET=change-me-to-a-32-character-secret-minimum
INTERNAL_API_KEY=bff-to-api-internal-key-change-me

# ============================================================
# BFF API GATEWAY (apps/bff)
# ============================================================
BFF_PORT=3006
API_CORE_GRPC_URL=localhost:50059
AUTH_GRPC_URL=localhost:50059

# ============================================================
# THIRD-PARTY INTEGRATIONS (Email, Storage & Notifications)
# ============================================================
# Email Provider: RESEND (requiere RESEND_API_KEY) | SES (requiere AWS_REGION + credenciales)
EMAIL_PROVIDER=RESEND
RESEND_API_KEY=
EMAIL_FROM=noreply@ultraerp.com
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=crm-storage
R2_BUCKET_NAME=nexora-kb-files   # Bucket específico para archivos de la Base de Conocimiento
R2_PUBLIC_URL=                   # CDN pública opcional, e.g. https://pub-xxxx.r2.dev

# Observabilidad (Opcional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================
# INTELIGENCIA ARTIFICIAL & MODELOS LLM (OpenAI / Local / Cloud)
# ============================================================
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE="0.7"

# Ejemplo para usar Ollama Localmente:
# OPENAI_BASE_URL="http://localhost:11434/v1"
# OPENAI_API_KEY=""
# OPENAI_MODEL="llama3:8b"

# Ejemplo para usar DeepSeek Cloud:
# OPENAI_BASE_URL="https://api.deepseek.com/v1"
# OPENAI_API_KEY="sk-tu-key-deepseek"
# OPENAI_MODEL="deepseek-chat"

# Ejemplo para usar Groq (Inferencia ultra-rápida):
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# OPENAI_API_KEY="gsk_tu-key-groq"
# OPENAI_MODEL="llama-3.3-70b-versatile"
