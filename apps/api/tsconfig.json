{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@crm/contracts": ["../../packages/contracts/dist"],
      "@crm/contracts/*": ["../../packages/contracts/dist/*"],
      "@crm/database": ["../../packages/database/dist"],
      "@crm/database/*": ["../../packages/database/dist/*"],
      "@crm/shared": ["../../packages/shared/dist"],
      "@crm/shared/*": ["../../packages/shared/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../packages/contracts" },
    { "path": "../../packages/database" },
    { "path": "../../packages/shared" }
  ]
}
